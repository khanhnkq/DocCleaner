{
  "manifest_version": 3,
  "name": "DocCleaner - Document Reader & PDF Formatter",
  "version": "1.3",
  "description": "Clean reading layout, remove clutter and ad banners, and format print-friendly HD PDF documents for study platforms.",
  "permissions": [
    "storage",
    "cookies",
    "scripting",
    "activeTab",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.studocu.com/*",
    "*://*.studocu.vn/*",
    "*://*.scribd.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DocCleaner - Document Reader & PDF Formatter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studocu.vn/*",
        "*://*.scribd.com/*"
      ],
      "css": [
        "custom_style.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studocu.vn/*",
        "*://*.scribd.com/*"
      ],
      "js": [
        "scribd_handler.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer_styles.css"
      ],
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studocu.vn/*",
        "*://*.scribd.com/*"
      ]
    }
  ]
}